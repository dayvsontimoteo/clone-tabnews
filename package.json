{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementando uma aplicação para fins de estudo das tecnologias utilizadas.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run db:up && next dev",
    "db:up": "docker compose -f infra/compose.yaml up -d",
    "db:stop": "docker compose -f infra/compose.yaml stop",
    "db:down": "docker compose -f infra/compose.yaml down ",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "author": "Dayvson Timoteo",
  "license": "MIT",
  "dependencies": {
    "next": "^13.1.6",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.6.2"
  }
}
